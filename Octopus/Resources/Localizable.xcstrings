          "stringUnit" : {
            "state" : "translated",
            "value" : "Run brew doctor"
          }
        }
      }
    },
    "Lancer l'aperçu" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
